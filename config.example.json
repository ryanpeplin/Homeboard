{
  "port": 8080,

  "display": {
    "background": "backgrounds/background-1366.jpg",
    "clock_24h": true,
    "background_dim": 0.15
  },

  "calendar": {
    "weeks": 4,
    "week_start": "sunday",
    "refresh_minutes": 10,
    "feeds": [
      { "name": "Me",       "color": "#d50000", "url": "https://calendar.google.com/calendar/ical/YOUR_ID/private-XXXX/basic.ics" },
      { "name": "Family",   "color": "#33b679", "url": "webcal://p01-caldav.icloud.com/published/2/XXXX" },
      { "name": "Holidays", "color": "#009688", "url": "https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics" }
    ]
  },

  "weather": {
    "lat": 40.7128,
    "lon": -74.0060,
    "units": "fahrenheit"
  },

  "fitbit": {
    "client_id": "",
    "client_secret": "",
    "goal": 0
  },

  "spotify": {
    "client_id": "",
    "client_secret": ""
  },

  "packages": {
    "email": "",
    "app_password": "",
    "days": 14,
    "keep_delivered_days": 2,
    "refresh_minutes": 15
  },

  "sleep": {
    "enabled": false,
    "awake": {
      "default": ["07:00", "22:00"],
      "sat": ["08:00", "23:30"],
      "sun": ["08:00", "23:00"]
    },
    "off_command": "WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 wlopm --off HDMI-A-1",
    "on_command": "WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 wlopm --on HDMI-A-1"
  }
}
